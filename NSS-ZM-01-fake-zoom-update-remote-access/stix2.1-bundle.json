      ],
      "id": "report--52b01b67-fd52-4c4b-aa37-1d3a476a0aee",
      "name": "Fake Zoom update page installs a self-hosted ScreenConnect client: technical analysis",
      "description": "A page made to look like a Zoom meeting tells the visitor their app is out of date and offers an update. The update is a ScreenConnect remote-access client set to call a server its sender runs; whoever runs it hands over control of their computer. NSS took the page from the day's new registrations, captured it, read the installer and traced it to that server within 23 hours of the page's registration. The server's domain was registered 63 days before the lure. None of the nine indicators was on any list NSS holds on 12 November 2026.",
      "report_types": [
        "threat-report"
      ],
      "published": "2026-11-12T00:00:00Z",
      "object_refs": [
        "indicator--45b796ab-3265-4d68-b664-55f1ea4cb1ba",
